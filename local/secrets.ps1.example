# =====================================================================
# local\secrets.ps1 -- passwords and connect strings. NOT IN GIT.
#
#   copy local\secrets.ps1.example local\secrets.ps1
#   then fill in the values below.
#
# WHY THIS FILE EXISTS. load-all.ps1 used to carry the passwords inline,
# which meant every copy of the repository carried them too -- including
# the ones on GitHub, and including every commit that ever touched the
# file. `local\secrets.ps1` is in .gitignore, so what you put here stays
# on your machine.
#
# If a password was ever committed, removing it from the file does not
# remove it from the history. Rotate it.
# =====================================================================

# ---- The catalog schema CP 360 writes to ----------------------------
$env:CP_CATALOG_DB_DSN   = "oracle://SILVER:CHANGE_ME@dvlpbdb1.testbbh.com:2483/pbdwhdbt"

# ---- Read-only harvest of the source warehouse ----------------------
$env:ORACLE_PROD_DSN     = "oracle://PBDWAPP:CHANGE_ME@dvlpbdb1.testbbh.com:2483/pbdwhdbt"

# ---- Variance 360: the warehouses it profiles -----------------------
$env:CP_VAR_PBDW_DSN     = "A041327:CHANGE_ME@qclpbdb1.testbbh.com:2483/PBDWHDBQ"
$env:CP_VAR_IMDS_DSN     = "imds_ro:CHANGE_ME@imds-host:1521/imdssvc"

# ---- Active Directory ------------------------------------------------
# Nothing to put here: CP 360 never holds an AD password. The bind uses
# the credentials the person types on the sign-in screen, and nothing is
# stored. CP_AD_* in load-all.ps1 are host names, not secrets.
