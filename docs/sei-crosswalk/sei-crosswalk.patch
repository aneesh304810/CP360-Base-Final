+      <tr><td><strong>Micro-batch boxed</strong></td><td>MB Start/End per partition, offset continuity</td><td>(mb, partition)</td><td>Start with no End; one partition stalled while others move</td></tr>
+      <tr><td><strong>Keys collapsed</strong></td><td>distinct keys per view per micro-batch</td><td>micro-batch</td><td>—</td></tr>
+      <tr><td><strong>JDBC pull</strong></td><td>rows returned, not-found keys</td><td>micro-batch</td><td>Micro-batch <code>FAILED</code>; not-found count above the delete rate</td></tr>
+      <tr><td><strong>Stage 1 load</strong></td><td>Stage 1 row count, Airflow task</td><td>micro-batch</td><td>Micro-batch <code>FAILED</code>, rolled back</td></tr>
+      <tr><td><strong>STG → INT → Gold</strong></td><td>Airflow <code>task_instance</code> + dbt run results</td><td>business date</td><td>Task failed; date stuck at <code>TRIGGER</code></td></tr>
+      <tr><td><strong>DQ and recon</strong></td><td><code>DQ_VALIDATION_FAILURE</code>, <code>RECON_RESULT</code></td><td>row / boundary</td><td>Held rows; unexplained boundary difference</td></tr>
